---
// Page shell for the blog/projects pages: head, header, main, footer.
// Not routed right now (see src/pages/_blog and _projects).
import BaseHead from "~/components/BaseHead.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import { SITE } from "~/site";

type Props = import("astro/types").ComponentProps<typeof BaseHead>;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("/rss.xml", Astro.site)}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
