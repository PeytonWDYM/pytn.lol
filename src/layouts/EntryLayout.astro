---
// Shared layout for a single blog post or project write-up.
import FormattedDate from "~/components/FormattedDate.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date | undefined;
  tags: string[];
  links?: { href: string; label: string }[];
}

const { title, description, date, updatedDate, tags, links = [] } = Astro.props;
---

<BaseLayout title={title} description={description} type="article">
  <article>
    <header class="entry-header">
      <h1>{title}</h1>
      <p>
        <FormattedDate date={date} />
        {updatedDate && (
          <>
            {" · updated "}
            <FormattedDate date={updatedDate} />
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
      {links.length > 0 && (
        <p class="entry-links">
          {links.map(({ href, label }) => (
            <a href={href}>{label}</a>
          ))}
        </p>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
